# CIP Monitor settings for `docker compose`. Copy to `.env` (same folder as docker-compose.yml) and edit.
# Every value here is a safe default or empty. Never commit a .env that holds real tokens or passwords.
# Keep comments on their own lines: Compose would read a comment after an empty value as the value.

# ---- Web server
# Port on the host.
CIP_PORT=8000

# ---- Data source
# replay = play the July 2026 log files; live = plant gateways POST readings to /api/readings.
CIP_MODE=replay
# Replay speed, x real time (60 = one simulated minute per second).
CIP_SPEED=60
# Replay: play live from this plant time, e.g. 2026-07-24 06:00. Empty = 2 days before the end of the logs.
CIP_START=
# Live mode: bearer token required on POST /api/readings. Set it whenever others can reach the port.
CIP_INGEST_TOKEN=
# Live mode: no reading for this many seconds shows "Stale".
CIP_STALE_AFTER_SECONDS=180

# ---- Storage (acknowledgements, audit log, run history), inside the container on the cip-state volume
CIP_DB_PATH=/state/cip_monitor.db

# ---- Name mapping for the 7 objects whose workbook rows lack an equipment code (rules/object_aliases.json)
# empty = on (all objects monitored, 561 Time alerts over July) | off = notebook numbers (221)
CIP_OBJECT_ALIASES=

# ---- Proposed temperature / flow / concentration rules (Proposed — pending Danone sign-off)
# off | show (alert panel only, no alerts) | alert (also raise alerts; trials with Danone only)
CIP_PROPOSED_RULES=show

# ---- Notifications: all off unless set; only alerts raised while live are sent
# Base URL of the page, for the "Open in CIP Monitor" link, e.g. http://cip-monitor.plant.local:8000
CIP_PUBLIC_URL=
# Teams incoming webhook or Workflows "post to a channel" URL. It is a secret.
CIP_TEAMS_WEBHOOK=
# Email: on when host, from and to are set. Port 465 = implicit TLS.
CIP_SMTP_HOST=
CIP_SMTP_PORT=587
CIP_SMTP_USER=
CIP_SMTP_PASSWORD=
CIP_SMTP_FROM=
# Comma-separated recipients.
CIP_SMTP_TO=
CIP_SMTP_STARTTLS=1
# Only these CIP lines, e.g. M11W01,M11W02. Empty = every line.
CIP_NOTIFY_LINES=
# Seconds between messages for one object.
CIP_NOTIFY_MIN_INTERVAL=300
# 1 = also notify while replaying the logs (demos only).
CIP_NOTIFY_IN_REPLAY=0
# Live mode: skip alerts more than this many plant minutes behind the newest reading (a backlog upload).
CIP_NOTIFY_MAX_LAG_MINUTES=10

TZ=UTC
